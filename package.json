{
  "name": "ultimate-linux-app-manager",
  "version": "1.0.0",
  "type": "module",
  "description": "Ultra-modern, glassmorphic Linux package manager, dependency intelligence utility & forensic software uninstaller",
  "main": "main.js",
  "author": "imObito",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "dist": "electron-builder --linux AppImage",
    "test": "node --test tests/*.test.js"
  },
  "build": {
    "appId": "com.xeno.ultimate-linux-app-manager",
    "productName": "Ultimate-Linux-App-Manager",
    "files": [
      "main.js",
      "preload.cjs",
      "staging/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release-dist"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "System",
      "synopsis": "Glassmorphic Linux Package Manager & Forensic Uninstaller",
      "description": "Ultra-modern, glassmorphic Linux package manager, dependency intelligence utility & forensic software uninstaller"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "framer-motion": "^13.4.0",
    "lucide": "^1.47.0",
    "lucide-static": "^1.47.0",
    "postcss": "^8.5.28",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  }
}
